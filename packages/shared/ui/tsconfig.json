{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "../../../tsconfig.base.json",
	"compilerOptions": {
		"target": "esnext",
		"lib": [ "dom", "dom.iterable", "esnext" ],
		"module": "esnext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"jsx": "react-jsx",
		"noEmit": true,
		"types": [ "bun", "vite/client" ]
	},
	"include": [ "src", "tests" ]
}
