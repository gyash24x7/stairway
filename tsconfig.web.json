{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": [ "dom", "dom.iterable", "esnext" ],
		"jsx": "react-jsx",
		"types": [ "bun", "vite/client" ]
	},
	"include": [
		"src/web",
		"src/ui",
		"src/auth/client",
		"src/engine",
		"src/schema",
		"src/utils",
		"src/contract",
		"src/games/*/client",
		"src/games/*/shared",
		"vite.config.ts"
	],
	"exclude": [ "node_modules" ]
}
