{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stairway",
	"main": "src/worker.tsx",
	"compatibility_date": "2025-08-21",
	"compatibility_flags": [ "nodejs_compat" ],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stairway",
			"database_id": "f8156d94-8c52-4c8d-aa85-45d2b839626e"
		}
	]
}
