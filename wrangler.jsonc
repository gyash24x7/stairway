{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "stairway",
	"main": "src/worker.ts",
	"compatibility_date": "2025-08-21",
	"compatibility_flags": [ "nodejs_compat" ],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"triggers": {
		"crons": [ "0 0 */2 * *" ]
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [ "/api/*" ]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "stairway",
			"database_id": "6905f0b3-6fc2-482c-bba0-28f946febd8d"
		}
	],
	"kv_namespaces": [
		{ "binding": "GAMES_KV", "id": "17c4fd81c2804fa786dc1814256b1f04" }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "WORDLE_ENGINE", "class_name": "WordleEngine" },
			{ "name": "TIC_TAC_TOE_ENGINE", "class_name": "TicTacToeEngine" },
			{ "name": "SPLENDOR_ENGINE", "class_name": "SplendorEngine" },
			{ "name": "FISH_ENGINE", "class_name": "FishEngine" },
			{ "name": "CALLBREAK_ENGINE", "class_name": "CallbreakEngine" },
			{ "name": "KINGDOMINO_ENGINE", "class_name": "KingdominoEngine" }
		]
	},
	// Migration history is append-only. v1/v3 created UserSession & SyncedStateServer;
	// v9 removes them now that sessions are D1-backed and realtime is disabled.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": [ "UserSession" ] },
		{ "tag": "v2", "new_sqlite_classes": [ "WordleEngine" ] },
		{ "tag": "v3", "new_sqlite_classes": [ "SyncedStateServer" ] },
		{ "tag": "v4", "new_sqlite_classes": [ "TicTacToeEngine" ] },
		{ "tag": "v5", "new_sqlite_classes": [ "SplendorEngine" ] },
		{ "tag": "v6", "new_sqlite_classes": [ "FishEngine" ] },
		{ "tag": "v7", "new_sqlite_classes": [ "CallbreakEngine" ] },
		{ "tag": "v8", "new_sqlite_classes": [ "KingdominoEngine" ] },
		{ "tag": "v9", "deleted_classes": [ "UserSession", "SyncedStateServer" ] }
	]
}
