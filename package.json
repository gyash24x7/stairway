		"@tsconfig/node24": "24.0.4",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.12.2",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "6.0.1",
		"drizzle-kit": "beta",
		"tailwindcss": "4.2.2",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.2",
		"vite": "8.0.8",
		"wrangler": "4.81.1"
	},
