{
	"name": "stairway",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.0.7",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"preview": "pnpm --filter @s2h/web preview",
		"clean": "rm -rf apps/web/node_modules/.vite",
		"typecheck": "turbo run typecheck",
		"generate": "pnpm --filter @s2h/web generate",
		"migrate:new": "pnpm --filter @s2h/web migrate:new",
		"migrate:dev": "pnpm --filter @s2h/web migrate:dev",
		"migrate:prod": "pnpm --filter @s2h/web migrate:prod"
	},
	"devDependencies": {
		"@tsconfig/node24": "catalog:",
		"@tsconfig/strictest": "catalog:",
		"turbo": "^2.5.8",
		"typescript": "catalog:"
	}
}
