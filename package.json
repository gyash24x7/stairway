{
	"name": "stairway",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "bun@1.4.0",
	"scripts": {
		"dev": "bun run --parallel dev:web dev:server",
		"dev:web": "bunx --bun vite",
		"dev:server": "bun src/server.ts",
		"build": "bunx --bun vite build",
		"start": "bun src/server.ts",
		"typecheck": "tsc --noEmit",
		"test": "bunx --bun vitest run",
		"test:watch": "bunx --bun vitest",
		"test:coverage": "bunx vitest run --coverage",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"preview": "vite preview",
		"db:generate": "bunx --bun drizzle-kit generate",
		"db:migrate": "bunx --bun drizzle-kit migrate",
		"db:check": "bunx --bun drizzle-kit check",
		"db:studio": "bunx --bun drizzle-kit studio"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"@effect/atom-react": "4.0.1",
		"@effect/platform-bun": "4.0.1",
		"@effect/sql-pg": "4.0.1",
		"@pixi/react": "8.0.5",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"class-variance-authority": "0.7.1",
		"cn": "0.4.0",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"effect": "4.0.1",
		"framer-motion": "14.0.0",
		"immer": "11.1.21",
		"lucide-react": "1.52.0",
		"pixi.js": "8.22.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.4.0",
		"sonner": "2.0.8",
		"unique-names-generator": "4.7.1",
		"usehooks-ts": "3.1.1",
		"vaul": "1.1.2"
	},
	"devDependencies": {
		"@effect/eslint-plugin": "0.3.2",
		"@effect/vitest": "4.0.1",
		"@stylistic/eslint-plugin": "5.10.0",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@tsconfig/bun": "1.0.11",
		"@tsconfig/strictest": "2.0.8",
		"@types/bun": "1.4.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/utils": "8.71.1",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.3",
		"drizzle-kit": "1.0.0-rc.5-5935859",
		"eslint-plugin-perfectionist": "5.12.1",
		"oxc-transform-react": "0.153.0",
		"oxlint": "1.87.0",
		"railway": "3.13.0",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	}
}
