{
	"name": "stairway",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev",
		"clean": "rm -rf ./node_modules/.vite",
		"typecheck": "tsc -b",
		"generate": "wrangler types ./types/env.d.ts",
		"migrate:new": "drizzle-kit generate",
		"migrate:dev": "wrangler d1 migrations apply DB --local",
		"migrate:prod": "wrangler d1 migrations apply DB --remote"
	},
	"dependencies": {
		"@base-ui/react": "1.4.1",
		"@simplewebauthn/browser": "13.3.0",
		"@simplewebauthn/server": "13.3.0",
		"@standard-schema/spec": "1.1.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cookie": "1.1.1",
		"drizzle-orm": "0.45.2",
		"framer-motion": "12.38.0",
		"lucide-react": "1.11.0",
		"react": "19.2.5",
		"react-dom": "19.2.5",
		"rwsdk": "1.2.4",
		"sonner": "2.0.7",
		"tailwind-merge": "3.5.0",
		"tslog": "4.10.2",
		"ulid": "3.0.2",
		"unique-names-generator": "4.7.1",
		"usehooks-ts": "3.1.1",
		"valibot": "1.3.1",
		"vaul": "1.1.2"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.33.2",
		"@tailwindcss/typography": "0.5.19",
		"@tailwindcss/vite": "4.2.4",
		"@tsconfig/node24": "24.0.4",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "25.6.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"drizzle-kit": "0.31.10",
		"tailwindcss": "4.2.4",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "7.3.2",
		"wrangler": "4.85.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		]
	}
