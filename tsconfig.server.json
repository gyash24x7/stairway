{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": [ "esnext" ],
		"types": [ "bun" ]
	},
	"include": [
		"src/worker.ts",
		"src/platform",
		"src/auth/server",
		"src/engine",
		"src/schema",
		"src/utils",
		"src/contract",
		"src/games/*/server",
		"src/games/*/shared",
		"alchemy.run.ts",
		"drizzle.config.ts"
	],
	"exclude": [ "node_modules" ]
}
