{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": [ "@tsconfig/node24", "@tsconfig/strictest" ],
	"compilerOptions": {
		// Each package sets "types" itself, pointing at apps/web/env.d.ts —
		// relative "types" entries resolve against the config that declares
		// them, so they cannot be inherited from here.
		"target": "esnext",
		"lib": [ "dom", "dom.iterable", "esnext" ],
		"module": "esnext",
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"jsx": "react-jsx",
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": false,
		"noEmit": true
	}
}
